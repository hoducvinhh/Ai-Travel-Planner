              "host": ["{{baseUrl}}"],
              "path": ["recommendations"]
            }
          }
        },
        {
          "name": "Train Model",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recommendations/train",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "train"]
            }
