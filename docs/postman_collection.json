              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"destination\": \"Lam Dong\",\n  \"budgetPerPerson\": 5000000,\n  \"days\": 3,\n  \"groupSize\": 2,\n  \"monthOfYear\": 11,\n  \"explicitPreferences\": [\"Nature\", \"Adventure\"]\n}"
            },
            "url": {
